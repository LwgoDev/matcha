local drawings = {}
local function square(x, y, w, h, color, filled, transparency, z)
    local d = Drawing.new("Square")
    d.Position = Vector2.new(x, y)
    d.Size = Vector2.new(w, h)
    d.Color = color
    d.Filled = filled ~= false
    d.Thickness = 1
    d.Transparency = transparency or 0
    d.ZIndex = 1000 + (z or 10)
    d.Visible = true
    drawings[#drawings + 1] = d
    return d
end

local function label(text, x, y, size, color, centered, z)
    local d = Drawing.new("Text")
    d.Text = text
    d.Position = Vector2.new(x, y)
    d.Size = size
    d.Color = color
    d.Center = centered == true
    d.Outline = true
    d.ZIndex = 1000 + (z or 20)
    d.Visible = true
    drawings[#drawings + 1] = d
    return d
end

local function drawPreview(x, y, w, h, kind)
    local purple = kind == "rorri"
    local accent = purple and Color3.fromRGB(126, 44, 255) or Color3.fromRGB(166, 166, 166)
    local dark = Color3.fromRGB(24, 25, 29)
    square(x, y, w, h, Color3.fromRGB(8, 9, 12), true, 0, 12)
    square(x + 2, y + 2, w - 4, 28, dark, true, 0, 13)
    label(purple and "AutoFarm" or "slayers 2", x + 13, y + 8, 14, Color3.fromRGB(240, 240, 245), false, 14)

    if purple then
        square(x + 2, y + 30, 42, h - 32, Color3.fromRGB(15, 16, 19), true, 0, 13)
        for i = 0, 6 do
            square(x + 15, y + 52 + i * 31, 14, 3, accent, true, 0, 15)
        end
        square(x + 54, y + 40, w - 66, h - 52, Color3.fromRGB(34, 35, 40), true, 0, 13)
        label("QUEST CYCLE", x + 68, y + 48, 10, accent, false, 15)
        for i = 0, 3 do
            local rowY = y + 76 + i * 42
            label(({"Full AutoFarm", "Select Quest", "Quest Mission Type", "Quest Wait"})[i + 1], x + 69, rowY, 10, Color3.fromRGB(218, 219, 225), false, 15)
            square(x + 69, rowY + 17, w - 100, 13, Color3.fromRGB(48, 50, 56), true, 0, 14)
            square(x + 72, rowY + 21, (w - 115) * 0.44, 5, accent, true, 0, 15)
        end
    else
        square(x + 2, y + 30, w - 4, 24, Color3.fromRGB(17, 18, 21), true, 0, 13)
        local tabs = {"farm", "teleport", "skills", "esp", "misc"}
        for i = 1, #tabs do
            label(tabs[i], x + 26 + (i - 1) * ((w - 42) / #tabs), y + 37, 9, Color3.fromRGB(210, 210, 215), false, 15)
        end
        local colW = (w - 30) * 0.47
        for col = 0, 1 do
            local cx = x + 10 + col * (colW + 8)
            square(cx, y + 62, colW, h - 76, Color3.fromRGB(33, 34, 38), true, 0, 13)
            label(col == 0 and "target" or "fight", cx + 10, y + 69, 10, Color3.fromRGB(230, 230, 235), false, 15)
            for row = 0, 5 do
                local ry = y + 96 + row * 29
                square(cx + 10, ry + 14, colW - 20, 7, Color3.fromRGB(55, 57, 63), true, 0, 14)
                square(cx + 10, ry + 14, (colW - 20) * (0.28 + row * 0.08), 7, Color3.fromRGB(170, 170, 180), true, 0, 15)
            end
        end
    end
end

