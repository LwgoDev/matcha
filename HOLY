local function makeButton(x, y, w, h, text, color)
    local bg = square(x, y, w, h, color, true, 0, 40)
    local border = square(x, y, w, h, Color3.fromRGB(245, 245, 250), false, 0.2, 41)
    local txt = label(text, x + w * 0.5, y + h * 0.5 - 7, 14, Color3.fromRGB(255, 255, 255), true, 42)
    return { x = x, y = y, w = w, h = h, bg = bg, border = border, text = txt, base = color }
end

