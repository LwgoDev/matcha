local running = true
local previousMouseDown = false
local function removeLauncher()
    if not running then return end
    running = false
    _G.StopSlayersLauncher = true
    _G.SlayersLauncherRunning = false
    for i = 1, #drawings do
        pcall(function() drawings[i]:Remove() end)
    end
end

local function runRemote(url, title, needsFullscreen)
    if needsFullscreen then
        notify("Ashs non-pro works best in Roblox fullscreen.", "Fullscreen Required", 5)
    end
    removeLauncher()
    task.spawn(function()
        local ok, err = pcall(function()
            local source = httpget(url)
            local chunk = loadstring(source)
            if not chunk then error("Could not compile " .. title) end
            chunk()
        end)
        if not ok then notify(tostring(err), "Launcher Error", 8) end
    end)
end

local buttons = {
    { data = atlasButton, url = "https://raw.githubusercontent.com/rorri-cm/slayer2test/refs/heads/main/slayers%202%20base.txt", title = "Atlas ( fast )" },
    { data = ashsRecommended, url = "https://raw.githubusercontent.com/LwgoDev/matcha/refs/heads/main/ASH", title = "Ashs ( recommended )" },
    { data = ashsNonPro, url = "https://raw.githubusercontent.com/Shoobie-code/slayers2/refs/heads/main/nopro", title = "Ashs ( non-pro )", fullscreen = true }
}

local lastHover = nil
task.spawn(function()
    while running and not _G.StopSlayersLauncher do
        local keyDown = iskeypressed and (iskeypressed(80) or iskeypressed(27))
        if keyDown then
            removeLauncher()
            break
        end

        local mx, my = mouse.X, mouse.Y
        local down = ismouse1pressed and ismouse1pressed() or false
        local hovered = nil
        for i = 1, #buttons do
            local b = buttons[i].data
            if mx >= b.x and mx <= b.x + b.w and my >= b.y and my <= b.y + b.h then
                hovered = i
                if down and not previousMouseDown then
                    local choice = buttons[i]
                    runRemote(choice.url, choice.title, choice.fullscreen)
                    return
                end
            end
        end
        if hovered ~= lastHover then
            for i = 1, #buttons do
                local b = buttons[i].data
                b.bg.Color = (i == hovered) and Color3.fromRGB(133, 101, 255) or b.base
            end
            lastHover = hovered
        end
        previousMouseDown = down
        task.wait(0.02)
    end
    if not running then return end
    removeLauncher()
end)

notify("Select a script. Press P or Escape to close.", "Slayers 2 Launcher", 5)
