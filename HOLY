local function tryImage(fileName, x, y, w, h)
    local bytes
    pcall(function()
        if isfile(fileName) then bytes = readfile(fileName) end
    end)
    if type(bytes) ~= "string" or #bytes == 0 then return end
    local image = Drawing.new("Image")
    image.Data = bytes
    image.Position = Vector2.new(x, y)
    image.Size = Vector2.new(w, h)
    image.Rounding = 4
    image.ZIndex = 1030
    image.Visible = true
    drawings[#drawings + 1] = image
end

